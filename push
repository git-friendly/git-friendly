#!/bin/bash
#
# Usage: push
#
# Send your local branch changes to the remote branch,
# and copy the relevant GitHub 'compare' URL to your clipboard (Mac/Linux only)
#
# Any extra args to this command will be passed through to 'git push',
# e.g. for doing "push -f"
#

# Abort if this isn't a git repository
git rev-parse --is-inside-work-tree >/dev/null || exit $?

# Get parent branch
# https://stackoverflow.com/a/17843908/1973105
function get_parent() {
  git show-branch | grep -F '*' | grep -v "$(git rev-parse --abbrev-ref HEAD)" | head -n1 | sed 's/.*\[\(.*\)\].*/\1/' | sed 's/[\^~].*//'
}

# Colors
color_error="$(tput sgr 0 1)$(tput setaf 1)"
color_reset="$(tput sgr0)"

# TODO DRY this b/w pull and push
branch=$(git branch --show-current) || exit $?
if [ -z "$branch" ]; then
  echo "${color_error}❌  You're not on a branch (detached HEAD). Check out a branch first.${color_reset}" >&2
  exit 1
fi
default_remote="origin"
remote=$(git config "branch.${branch}.remote" || echo "$default_remote")
remote_branch=$( (git config "branch.${branch}.merge" || echo "refs/heads/$branch") | cut -d/ -f3-)

# Push, letting git write straight to the terminal. Capturing the output would
# swallow pre-push hooks (lint, typecheck, tests), which can run for minutes
# with nothing on screen, and hooks that check for a tty would drop their
# progress display. So read what happened from the refs instead of the output.
if [ $# -eq 0 ]; then
  args=("$remote" "$remote_branch")
else
  args=("$@")
fi

# Where the remote branch stood before the push, so we can tell afterwards
# whether we created it, moved it, or changed nothing.
before=$(git rev-parse --short "refs/remotes/$remote/$remote_branch" 2>/dev/null)

git push --set-upstream "${args[@]}"
exit_code=$?

if [ $exit_code != 0 ]; then
  echo -e "\n${color_error}Ouch, push failed!${color_reset}" >&2
  exit $exit_code
fi

after=$(git rev-parse --short HEAD)

if [ -z "$before" ]; then
  echo -e "\n🚀  Pushed a new branch '$branch' remotely"
elif [ "$before" = "$after" ]; then
  echo -e "\n✌️  Git says everything is up-to-date!"
  exit 0
else
  commit_range="$before..$after"
fi

# Build compare refs: commit hashes for main/master, branch names for feature branches
if [ ! -z "$commit_range" ] && { [ "$branch" = "main" ] || [ "$branch" = "master" ]; }; then
  refs="$commit_range"
else
  parent=$(get_parent)
  refs="${parent:-main}...$branch"
fi

# Build GitHub URL: prefer PR URL > compare URL
remote_url=$(git remote get-url --push $remote)

if [[ "$remote_url" =~ github\.com ]]; then

  if [[ ${remote_url:0:4} == "git@" ]]; then
    regEx='s/.*\:\(.*\)\.git/\1/'
    url='https://github.com/'
  else
    regEx='s/\(.*\)\.git/\1/'
  fi

  repo_name=$(echo $remote_url | sed $regEx)

  # GitHub prints its own "create a pull request" URL during the push, so we
  # only look up an already-open PR here and fall back to the compare URL.
  if [ "$branch" != "main" ] && [ "$branch" != "master" ] && command -v gh >/dev/null 2>&1; then
    pr_number=$(gh pr list --head "$branch" --json number --jq '.[0].number' 2>/dev/null)
    if [ ! -z "$pr_number" ] && [ "$pr_number" != "null" ]; then
      github_url="$url$repo_name/pull/$pr_number"
    fi
  fi

  github_url="${github_url:-$url$repo_name/compare/$refs}"

  # Copy to clipboard unless switched off; empty, 0 and false all count as off
  case "$GIT_FRIENDLY_NO_COPY_URL_AFTER_PUSH" in
    '' | 0 | false)
      copied="\nCopied URL to clipboard:"
      command -v pbcopy >/dev/null 2>&1 && echo $github_url | pbcopy && echo -e "$copied"
      command -v xclip >/dev/null 2>&1 && echo $github_url | xclip -selection clipboard && echo -e "$copied"
      ;;
  esac

  echo $github_url
fi

exit 0
